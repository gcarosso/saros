<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Readout Radar weekly refresh: pull → process → build → test, Mondays 06:00 local time (this Mac is on Pacific time).
       Install with `make install-launchd` (copies to ~/Library/LaunchAgents and loads it); remove with `make uninstall-launchd`.
       No credentials: every source is public (ClinicalTrials.gov, openFDA, SEC EDGAR).
       Log: data/refresh.log (git-ignored). If the Mac is asleep at 06:00, launchd runs the job at the next wake. -->
  <key>Label</key><string>com.readoutradar.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/make</string>
    <string>-C</string>
    <string>__REPO__</string>
    <string>refresh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>StandardOutPath</key><string>__REPO__/data/refresh.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/refresh.log</string>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
